# =============================================================================
# .env.example — Environment Variables for Yellow Pages Chatbot
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── LangSmith Observability ───────────────────────────────────────────────────
# Sign up at https://smith.langchain.com to get your API key.
# When enabled, every LLM call + agent trace is visible in the LangSmith dashboard.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=yellowpages-chatbot

# ── App Config ────────────────────────────────────────────────────────────────
FLASK_ENV=production
PORT=5000
